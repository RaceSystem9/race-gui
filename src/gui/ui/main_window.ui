        <string notr="true">/* QSpinBox 본체 */
QSpinBox {
    font-size: 18px;
    font-weight: bold;
    border: 1px solid #4d5d75;
    border-radius: 4px;
    padding-left: 2px;
    padding-right: 57px;        /* 버튼 2개(28px * 2) + 여백 1px */
    
    /* 전체 크기 90px * 28px 고정 */
    min-width: 90px;
    max-width: 90px;
    min-height: 28px;
    max-height: 28px;
    
    qproperty-alignment: 'AlignHCenter | AlignVCenter';
}

/* [왼쪽 버튼] Up-button (파란색) */
QSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 28px;
    height: 100%;
    margin-right: 28px;
    border-left: 1px solid #4d5d75;
    border-right: 1px solid #4d5d75;
    background-color: #3b82f6; /* 파란색 */
}

QSpinBox::up-button:hover { 
    background-color: #2563eb; 
}

QSpinBox::up-button:pressed { 
    background-color: #1d4ed8; 
}

/* [오른쪽 버튼] Down-button (주황색) */
QSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 28px;
    height: 100%;
    margin-right: 0px;
    border-left: 1px solid #4d5d75;
    background-color: #f97316; /* 주황색 */
}

QSpinBox::down-button:hover { 
    background-color: #ea580c; 
}

QSpinBox::down-button:pressed { 
    background-color: #c2410c; 
}

/* [기호 숨김] 화살표/삼각형 아이콘 제거 */
QSpinBox::up-arrow,
QSpinBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
}</string>
